# Written automatically by `bun run setup` — you should not need to edit this by hand.

# GMAIL_PASS must be an app password: https://myaccount.google.com/apppasswords
GMAIL_EMAIL=
GMAIL_PASS=

BLINK_EMAIL=
BLINK_PASS=

# Any stable, unique string. Blink ties your 2FA verification to it, so
# changing it forces a new PIN prompt. Setup generates one for you.
BLINK_CLIENT=

# Comma separated list of Blink network (sync module) names to arm and disarm.
BLINK_NETWORKS="Indoors,Outdoors"

# Where to email a summary after each sync. Leave blank or remove the line to
# switch the notification emails off entirely.
NOTIFY_EMAIL=

# Optional: debug | info | warn | error (default: info)
# LOG_LEVEL=info
