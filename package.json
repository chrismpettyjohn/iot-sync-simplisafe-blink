{
    "name": "iot-sync-simplisafe-blink",
    "version": "0.0.1",
    "type": "module",
    "bin": {
        "iot-sync": "src/cli.ts"
    },
    "scripts": {
        "start": "bun run src/cli.ts start",
        "setup": "bun run src/cli.ts setup",
        "typecheck": "tsc --noEmit",
        "test": "LOG_LEVEL=silent bun test",
      "build": "bun build src/cli.ts --target=bun --outdir=dist"
    },
    "dependencies": {
        "chalk": "6.0.0",
        "dotenv": "18.0.1",
        "imapflow": "2.0.5",
        "nodemailer": "10.0.10",
        "mailparser": "3.9.28"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "@types/mailparser": "3.4.6",
        "@types/node": "26.6.2",
        "@types/nodemailer": "8.0.2",
        "typescript": "7.0.2"
    },
    "engines": {
        "node": ">=22.0.0",
        "bun": ">=1.0.0"
    },
    "engineStrict": true
}
